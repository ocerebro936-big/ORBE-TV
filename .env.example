# UBlue TV - Environment Variables Template
# Copy this file to .env.local and fill in your values

# =============================================================================
# TMDB (The Movie Database) - Filmes, Séries, Favoritos
# Obtenha sua chave em: https://www.themoviedb.org/settings/api
# =============================================================================
VITE_TMDB_API_KEY=

# =============================================================================
# OMDb API - Metadados de TV Linear e Filmes
# Obtenha sua chave em: http://www.omdbapi.com/apikey.aspx
# =============================================================================
VITE_OMDB_API_KEY=

# =============================================================================
# Google Generative AI (Gemini) - AI Engine Studio
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
# =============================================================================
VITE_GEMINI_API_KEY=

# =============================================================================
# Rei dos Canais API - Esportes BR e Canais Ao Vivo
# Obtenha acesso em: https://reidoscanais.si
# =============================================================================
VITE_REIDOSCANAIS_API_KEY=

# =============================================================================
# NetCombo / Claro TV Solr EPG Gatekeeper
# Para programação de canais brasileiros
# =============================================================================
VITE_NETCOMBO_API_KEY=

# =============================================================================
# Configurações de Desenvolvimento
# =============================================================================

# Desabilita HMR (Hot Module Replacement) - útil para evitar flickering
# DISABLE_HMR=true

# Porta do servidor de desenvolvimento (padrão: 3000)
# PORT=3000

# Host do servidor (padrão: 0.0.0.0 para acesso na rede local)
# HOST=0.0.0.0